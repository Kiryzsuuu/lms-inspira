# ─────────────────────────────────────────────────────────────────────────────
# LMS Inspira — Environment Variables untuk Biznet GIO Cloud
#
# CARA PAKAI:
#   cp .env.biznet.example .env.production
#   nano .env.production   # isi semua nilai yang diperlukan
#
# File ini TIDAK boleh di-commit ke git dengan nilai asli.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas (gratis tier tersedia di cloud.mongodb.com)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/lms?retryWrites=true&w=majority

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_MIN_64_KARAKTER

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL frontend Anda (domain publik). Bisa comma-separated jika lebih dari satu.
# Contoh: https://lms.contoh.id
# Contoh multi: https://lms.contoh.id,https://www.lms.contoh.id
CLIENT_ORIGIN=https://DOMAIN_ANDA

# ── Midtrans Payment Gateway ──────────────────────────────────────────────────
# Ambil dari dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true = production (uang sungguhan), false = sandbox (testing)
MIDTRANS_IS_PRODUCTION=false
# Persentase fee Midtrans (opsional, untuk laporan akuntansi)
MIDTRANS_FEE_PERCENT=0

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: aktifkan 2FA lalu buat App Password di myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Nama + email pengirim (opsional, default ke SMTP_USER)
SMTP_FROM="Nama Aplikasi <email@gmail.com>"
